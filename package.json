  "repository": {
    "type": "git",
    "url": "https://github.com/senecajs/seneca.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGES.md",
    "lib",
    "seneca.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "seneca.js",
  "types": "seneca.d.ts",
  "scripts": {
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "test": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"lib/*.js\" --test-coverage-include=seneca.js --test-coverage-lines=85 --test-reporter=spec --test-reporter-destination=stdout \"test/*.test.js\"",
    "test-some": "node --test --test-concurrency=1 \"test/*.test.js\" --test-name-pattern",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"lib/*.js\" --test-coverage-include=seneca.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.js\"",
    "smoke": "node test/stubs/launch.js",
    "prettier": "prettier --write *.js lib/*.js test/*.js",
    "clean": "rm -rf node_modules package-lock.json yarn.lock",
    "reset": "npm run clean && npm i && npm run build && npm test"
  },
  "dependencies": {
    "eraro": "^3.1.0",
    "fast-safe-stringify": "^2.1.1",
    "gate-executor": "^3.1.1",
    "gubu": "^9.0.0",
    "jsonic": "^2.16.0",
    "lodash.defaultsdeep": "^4.6.1",
    "lodash.flatten": "^4.4.0",
    "lodash.uniq": "^4.5.0",
    "minimist": "^1.2.8",
    "nid": "^2.0.1",
    "ordu": "^2.2.0",
    "patrun": "^7.2.7",
    "rolling-stats": "^0.2.1",
    "use-plugin": "^13.2.0"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "@seneca/test-plugin": "0.1.0",
    "@types/node": "^24.0.0",
    "async": "^3.2.6",
    "bench": "^0.3.6",
    "gex": "^4.0.1",
    "handlebars": "^4.7.8",
    "lolex": "^6.0.0",
    "prettier": "^3.4.2",
    "seneca-entity": "^28.1.0",
    "seneca-error-test": "^0.2.2",
    "seneca-promisify": "^3.7.2",
    "summary": "^2.1.0",
    "typescript": "^5.7.3"
  }
}
